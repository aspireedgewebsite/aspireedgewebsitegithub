# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/aspireedge

# Port the Express API listens on
PORT=5000

# Secret used to sign JWT auth tokens - use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret

# JWT expiry (e.g. 7d, 12h, 30m)
JWT_EXPIRES_IN=7d

# SMTP settings for sending contact-form / registration email notifications.
# For Gmail: use an "App Password", not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Address that receives contact-form and registration notifications
NOTIFY_EMAIL=connect@aspireedge.com

# Address shown as the "from" sender of outgoing mail
MAIL_FROM="AspireEdge Website <no-reply@aspireedge.com>"

# Client origin allowed to call this API (for CORS) during local dev
CLIENT_ORIGIN=http://localhost:5173
